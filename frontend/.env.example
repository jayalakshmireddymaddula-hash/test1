# ==============================================================
# Gemini AI Nexus - Frontend Environment Configuration
# ==============================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for browser / client-side use)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API Endpoint URL (Used when running frontend separately)
API_BASE_URL=http://localhost:5000/api
