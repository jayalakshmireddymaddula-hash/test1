# ==============================================================
# Gemini LLM Chatbot - Backend Environment Configuration
# ==============================================================

# Server Port (Default is 5000)
PORT=5000

# Your Google Gemini API Key:
# Obtain free from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Default Model (e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
DEFAULT_MODEL=gemini-1.5-flash

# --------------------------------------------------------------
# Supabase Configuration (Database & Chat History Persistence)
# --------------------------------------------------------------
# Supabase Project URL (e.g., https://yourproject.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Public key for client requests)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (Admin key for secure backend database operations)
# WARNING: Keep this secret! Never expose in public client code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Database Password (Optional: used by 'npm run db:migrate' to auto-create tables)
# (Your Supabase project database password)
DATABASE_PASSWORD=

# Direct Postgres Connection URL (Optional alternative for migrations)
DATABASE_URL=
